# Optional extra bootstrap account (baked in at build time).
# The demo account rohitbohara / rohitbohara is always seeded in localStorage.
# Either pair works: VITE_AUTH_USER/PASS or VITE_AUTH_USERNAME/PASSWORD.
VITE_AUTH_USER=rohitbohara
VITE_AUTH_PASS=rohitbohara
VITE_AUTH_USERNAME=rohitbohara
VITE_AUTH_PASSWORD=rohitbohara
