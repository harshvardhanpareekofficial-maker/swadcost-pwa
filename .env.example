# Optional. Do not put real passwords in git.
# Accounts are created in the studio — nothing is seeded into localStorage.

# Owner vault gate (fallback is baked in if unset). Do not publish this path in marketing copy.
VITE_OWNER_GATE=

# Shared analytics (no passwords). Bake the anon key at build time on Render.
# Required for Finish setup: Sign in looks up swadcost_accounts.username_norm.
# An empty key means the client cannot check the studio list (config error, not “no account”).
# Tables stay swadcost_accounts / swadcost_calcs (backend IDs, not shown in UI).
# After deploy, apply supabase/migrations/20260911_last_active_idle_purge.sql so last_active_at exists.
VITE_SUPABASE_URL=https://stcjwprffdsojfeogfnx.supabase.co
VITE_SUPABASE_ANON_KEY=
